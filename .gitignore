# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-wsl

# Local data (DB, media cache, exports)
data/
.env

# Opt-in raw-WeChat experiment: never commit copied/encrypted/decrypted DBs,
# WAL/SHM files, memory material, recovered keys, or exported chat content.
experimental/raw_wechat/workspace/
experimental/raw_wechat/**/*.db
experimental/raw_wechat/**/*.db-*
experimental/raw_wechat/**/*.key
experimental/raw_wechat/**/*keys*.json
experimental/raw_wechat/**/*.dump
experimental/raw_wechat/**/*.json

# Claude Code: ignore by default, carve out the parts that codify project contracts
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/__pycache__/
# settings.local.json (per-user permissions) and skills/ (per-user installs) stay ignored

# wx4py drops a log + send-audit jsonl next to the cwd when imported
wx4py.log
wx4py_send_audit.jsonl

# Codex
.codex/
!.codex/settings.json
!.codex/hooks/
.codex//hooks/__pycache__/
.agents/skills
